# Python / virtual environments
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
.env
*_env/          # Catch servo_env and other named environments
animatronic_env/
servo_env/      # Specifically our servo environment

# Python runtime artifacts
*.pyc
.pytest_cache/
.coverage
htmlcov/
.tox/
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Generated lip-sync & audio artifacts (default ignore)
*.lipsync.json
*.rhubarb.json
*.wav
*.m4a
*.mp3
*.flac
*.ogg

# Bundles (now created at repo root via --bundle-root). We want bundles tracked
# except large/binary audio assets. Global patterns still ignore *.lipsync.json,
# so we re-allow those inside bundles.
!bundles/**/manifest.json
!bundles/**/*.txt
!bundles/**/*.lipsync.json
!bundles/**/rhubarb.raw.json
!bundles/**/*.json
bundles/**/*.wav
bundles/**/*.m4a
bundles/**/*.mp3
bundles/**/*.flac
bundles/**/*.ogg
bundles/**/original.*

# Speech / alignment models (large) – keep placeholder docs
pipeline/models/
!pipeline/models/.gitkeep
!pipeline/models/README.md

# Allow a readme in tools cache
!pipeline/tools_cache/README.md

# Logs
*.log
debug.log
error.log

# Hardware/Runtime specific
*.lgd-nfy*      # GPIO notification files
setup_*_test.sh # Hardware setup scripts
HARDWARE_TESTING_LOG.md
QUICK_REFERENCE.md

# Development and testing artifacts
test_*.py
*_test_*.py
diagnostic_*.py
*_diagnostic.py
temp_*.py
scratch_*.py

# Editor / OS noise
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# macOS
.AppleDouble
.LSOverride

# Archives / downloads
*.zip
*.tar
*.tar.gz
*.7z

# CLion
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#cmake-build-*
servo_env/
**/servo_env/
